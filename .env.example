# Estas variables son públicas y se incluyen en el JavaScript del navegador.
# Nunca pongas aquí claves privadas, tokens de Google ni credenciales de nube.
VITE_EVENT_NAME=Nuestro evento
VITE_EVENT_ID=mi-evento
# local: descargar/compartir sin enviar nada. endpoint: servidor propio.
VITE_STORAGE_MODE=local
# Solo completar en modo endpoint. Ejemplo: /api/photobooth
VITE_STORAGE_ENDPOINT=
# ./ permite alojarlo también en una subcarpeta de cualquier website.
VITE_BASE_PATH=./
